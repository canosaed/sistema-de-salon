# URL base local de la aplicación
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Reemplazar por valores aleatorios propios (no usar estos textos como secretos)
BETTER_AUTH_SECRET=reemplazar_por_un_secreto_aleatorio_de_32_caracteres_o_mas
SALON_SETUP_TOKEN=reemplazar_por_un_token_aleatorio_de_32_caracteres_o_mas

# PostgreSQL local; ajustar usuario, contraseña, host, puerto y base según tu instalación
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atelier_beauty
